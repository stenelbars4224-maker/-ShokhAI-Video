
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI(title="ShokhAI-Video API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "https://stenelbars4224-maker.github.io",
    ],
    allow_methods=["GET", "POST"],
    allow_headers=["Content-Type"],
)


@app.get("/")
def home():
    return {
        "status": "ShokhAI-Video server ishlayapti"
    }


@app.post("/generate")
def generate_video(data: dict):
    prompt = data.get("prompt", "").strip()
    style = data.get("style", "cinematic")

    if not prompt:
        return {
            "success": False,
            "message": "Video g'oyasini kiriting"
        }

    return {
        "success": True,
        "message": "Server so'rovni qabul qildi",
        "prompt": prompt,
        "style": style
    }
