
import os

from fastapi import FastAPI, HTTPException
from fastapi.responses import Response
from pydantic import BaseModel
from huggingface_hub import InferenceClient

app = FastAPI(title="ShokhAI-Video API")


class VideoRequest(BaseModel):
    prompt: str


@app.get("/")
def home():
    return {"status": "ShokhAI-Video server ishlayapti"}


@app.post("/generate")
def generate_video(request: VideoRequest):
    token = os.getenv("HF_TOKEN")

    if not token:
        raise HTTPException(
            status_code=500,
            detail="HF_TOKEN sozlanmagan"
        )

    if not request.prompt.strip():
        raise HTTPException(
            status_code=400,
            detail="Video tavsifini kiriting"
        )

    try:
        client = InferenceClient(
            provider="fal-ai",
            api_key=token
        )

        video = client.text_to_video(
            request.prompt,
            model="Wan-AI/Wan2.2-TI2V-5B"
        )

        return Response(
            content=video,
            media_type="video/mp4"
        )

    except Exception:
        raise HTTPException(
            status_code=502,
            detail="Video xizmati ishlamadi. Token, modelga kirish huquqi va provayder to‘lovini tekshiring."
        )
